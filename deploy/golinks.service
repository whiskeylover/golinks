[Unit]
Description=go/links URL shortener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=golinks
Group=golinks
WorkingDirectory=/var/lib/golinks
ExecStart=/usr/local/bin/golinks serve -addr :80 -db /var/lib/golinks/golinks.db
Restart=on-failure
RestartSec=3s

# Allow the unprivileged service user to listen on HTTP port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Keep the service constrained to its data directory.
StateDirectory=golinks
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/golinks

[Install]
WantedBy=multi-user.target

